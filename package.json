{
  "name": "criacord",
  "version": "0.2.1",
  "description": "Private zero-config voice and high-quality screen sharing for small groups.",
  "main": "dist-electron/main/index.js",
  "author": "CriaCord",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:win": "npm run build:ptt && npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:electron && vitest run --root .",
    "test:watch": "vitest --root .",
    "lint": "eslint .",
    "pack": "npm run build && electron-builder --dir",
    "release": "npm run build:ptt && npm run build && electron-builder --win --x64 --publish always",
    "build:ptt": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-ptt-helper.ps1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.criacord.desktop",
    "productName": "CriaCord",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "CriaCord-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CriaCord"
    },
    "portable": {
      "artifactName": "CriaCord-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "native/CriaCordPttHelper.exe",
        "to": "native/CriaCordPttHelper.exe"
      }
    ]
  }
}
