{
  "name": "criacord",
  "version": "0.3.0",
  "description": "Private zero-config P2P voice and high-quality screen sharing for small groups.",
  "author": "CriaCord",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "build:win": "npm run typecheck && tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "lint": "eslint .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
